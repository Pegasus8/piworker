# PiWorker Development Dockerfile
# Uses air for hot reload during development

FROM golang:1.27.1-alpine

# Install build dependencies and air
RUN apk add --no-cache gcc musl-dev git && \
    go install github.com/air-verse/air@latest

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source (will be overwritten by volume mount)
COPY . .

# Create data directory
RUN mkdir -p /app/data

# Expose port
EXPOSE 8080

# Use air for hot reload
CMD ["air", "-c", ".air.toml"]
