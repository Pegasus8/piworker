#!/usr/bin/env bash
# Manage the native Linux/systemd installation. No build tools required.
set -Eeuo pipefail
umask 077

BIN=/usr/local/bin
CONFIG=/etc/piworker
DATA=/var/lib/piworker
BACKUPS=/var/backups/piworker
UNIT=/etc/systemd/system/piworker.service
LOCK=/run/lock/piworker-install.lock
RELEASES=https://github.com/Pegasus8/piworker/releases
work='' backup='' rollback=0 newconfig='' health_url=''

die() { echo "PiWorker: $*" >&2; exit 1; }
usage() {
    cat <<'EOF'
Usage: sudo piworkerctl install [vVERSION]
       sudo piworkerctl update [vVERSION]
       sudo piworkerctl uninstall
       sudo piworkerctl tls on|off

Install/update defaults to the latest stable GitHub release.
Uninstall preserves accounts, flows, configuration and backups.
Requires Linux with systemd, glibc 2.35+, curl and tar.
Supports x86_64, aarch64 and ARMv7 (not ARMv6).
PiWorker serves HTTPS (port 8443) with its own local CA; port 8080 redirects.
"tls off" switches to plain HTTP (recovery, or behind your own proxy); "tls on"
restores HTTPS with the local CA. Both restart the service.
The health check follows addr and [tls] mode in the configuration; set
PIWORKER_HEALTH_URL to override it.
Set PIWORKER_RELEASE_DIR to use local release files (explicit vVERSION required).
EOF
}

action=${1:-help}
version='' tlsmode=''
case "$action" in
    help|-h|--help) usage; exit 0 ;;
    install|update) [ "$#" -le 2 ] || die "Too many arguments."; version=${2:-} ;;
    uninstall) [ "$#" -eq 1 ] || die "Uninstall takes no options; data is always preserved." ;;
    tls)
        [ "$#" -eq 2 ] || die "Usage: sudo piworkerctl tls on|off"
        case "$2" in
            on) tlsmode=auto ;;
            off) tlsmode=off ;;
            *) die "Usage: sudo piworkerctl tls on|off" ;;
        esac ;;
    *) usage >&2; exit 1 ;;
esac
if [ -n "$version" ]; then
    [[ "$version" =~ ^v[0-9][a-zA-Z0-9.+-]*$ ]] || die "Invalid release tag: $version"
fi
[ "$(uname -s)" = Linux ] || die "Use Docker on macOS/Windows; this installer requires Linux."
[ "$(id -u)" = 0 ] || die "Run with sudo (administrator privileges are required)."
command -v systemctl >/dev/null || die "systemd is required."
mkdir -p "${LOCK%/*}"
mkdir "$LOCK" 2>/dev/null || die "Another lifecycle operation is running (lock: $LOCK)."

cleanup() {
    local result=$?
    trap - EXIT
    set +e
    if [ "$rollback" = 1 ]; then
        echo "Update failed. Restoring binary and data from $backup" >&2
        # Never restore a database while its process might still be writing.
        if systemctl stop piworker.service; then
            if cp -p "$backup/piworker" "$BIN/piworker.restore" &&
               mv "$DATA" "$backup/failed-data" &&
               cp -a "$backup/data" "$DATA" &&
               mv -f "$BIN/piworker.restore" "$BIN/piworker"; then
                systemctl start piworker.service || echo "Recovery could not start the service; inspect journalctl -u piworker." >&2
            else
                echo "Recovery failed. Service left stopped; restore manually from $backup." >&2
            fi
        else
            echo "Cannot stop service. Restore manually from $backup before restarting." >&2
        fi
    fi
    [ -z "$work" ] || rm -rf "$work"
    [ -z "$newconfig" ] || rm -f "$newconfig"
    rm -f "$BIN/piworker.new" "$BIN/piworkerctl.new"
    rmdir "$LOCK"
    exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# toml_value SECTION KEY: the quoted string value of KEY in [SECTION] of the
# configuration ("" is the top level). Enough for the keys this script reads.
toml_value() {
    [ -f "$CONFIG/piworker.toml" ] || return 0
    awk -v section="$1" -v key="$2" '
        /^[[:space:]]*\[/ { current = $0; gsub(/^[[:space:]]*\[[[:space:]]*|[[:space:]]*\].*$/, "", current); next }
        current == section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
            value = $0; sub(/^[^=]*=[[:space:]]*"/, "", value); sub(/".*$/, "", value); print value; exit
        }' "$CONFIG/piworker.toml"
}
listen_port() { local addr; addr=$(toml_value "" addr); addr=${addr:-:8443}; echo "${addr##*:}"; }
tls_mode() { local mode; mode=$(toml_value tls mode); echo "${mode:-auto}"; }

# healthy checks the local health endpoint as the configuration serves it:
# HTTPS verified against the local CA (auto), HTTPS on loopback without
# verification (custom: the certificate may not name 127.0.0.1), or HTTP (off).
healthy() {
    local url=${PIWORKER_HEALTH_URL:-} mode tls=()
    mode=$(tls_mode)
    if [ -z "$url" ]; then
        if [ "$mode" = off ]; then
            url=http://127.0.0.1:$(listen_port)/api/health
        else
            url=https://127.0.0.1:$(listen_port)/api/health
        fi
    fi
    if [[ "$url" == https://* ]]; then
        if [ "$mode" = auto ]; then tls=(--cacert "$DATA/tls/ca.crt"); else tls=(--insecure); fi
    fi
    health_url=$url
    curl --fail --silent --show-error --noproxy '*' --connect-timeout 2 --max-time 3 "${tls[@]}" "$url" >/dev/null 2>&1
}
wait_healthy() {
    local attempt
    for ((attempt=0; attempt<15; attempt++)); do
        if systemctl is-active --quiet piworker.service && healthy; then
            return 0
        fi
        sleep 1
    done
    return 1
}

# ca_fingerprint prints the local CA fingerprint in PiWorker's format.
ca_fingerprint() {
    local out
    command -v openssl >/dev/null && [ -f "$DATA/tls/ca.crt" ] || return 1
    out=$(openssl x509 -in "$DATA/tls/ca.crt" -noout -fingerprint -sha256 2>/dev/null) || return 1
    out=${out#*=}
    [[ "$out" =~ ^([0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2}$ ]] || return 1
    printf 'SHA256:%s\n' "${out^^}"
}
print_access() {
    local port mode host fingerprint
    port=$(listen_port)
    mode=$(tls_mode)
    host=$(hostname 2>/dev/null || cat /proc/sys/kernel/hostname)
    host=${host%%.*}.local
    if [ "$mode" = off ]; then
        echo "PiWorker is running without HTTPS. Open http://$host:$port (or http://<device-address>:$port)."
        return 0
    fi
    echo "Open https://$host:$port (or https://<device-address>:$port). Plain http:// (port 8080 by default) redirects there."
    [ "$mode" = auto ] || return 0
    if fingerprint=$(ca_fingerprint); then
        echo "CA fingerprint: $fingerprint"
    else
        echo "CA fingerprint: sudo journalctl -u piworker | grep 'CA fingerprint'"
    fi
    echo "Trust the CA once per device (compare the fingerprint): https://$host:$port/trust"
}

# set_tls_mode writes [tls] mode right after the section header (adding the
# section if needed) and keeps every other line of the configuration.
set_tls_mode() {
    newconfig=$(mktemp "$CONFIG/.piworker.toml.XXXXXX")
    awk -v mode="$1" '
        function emit() { print "mode = \"" mode "\""; done = 1 }
        /^[[:space:]]*\[/ {
            name = $0; gsub(/^[[:space:]]*\[[[:space:]]*|[[:space:]]*\].*$/, "", name)
            intls = (name == "tls"); print
            if (intls && !done) emit()
            next
        }
        intls && /^[[:space:]]*mode[[:space:]]*=/ { next }
        { print }
        END { if (!done) { print ""; print "[tls]"; emit() } }' "$CONFIG/piworker.toml" > "$newconfig"
    chown root:piworker "$newconfig"
    chmod 640 "$newconfig"
    mv -f "$newconfig" "$CONFIG/piworker.toml"
    newconfig=''
}

managed=0
[ ! -f "$CONFIG/installed-version" ] || managed=1
if [ "$action" = uninstall ]; then
    [ "$managed" = 1 ] || die "No managed installation found; refusing to remove a manual installation."
    systemctl disable --now piworker.service
    rm -f "$UNIT" "$BIN/piworker" "$BIN/piworkerctl" "$CONFIG/installed-version"
    systemctl daemon-reload
    echo "PiWorker uninstalled. Data: $DATA; configuration: $CONFIG; backups: $BACKUPS."
    exit 0
fi
if [ "$action" = tls ]; then
    [ "$managed" = 1 ] || die "No managed installation found. Edit [tls] mode in your piworker.toml instead."
    set_tls_mode "$tlsmode"
    systemctl restart piworker.service
    wait_healthy || die "Health check failed at $health_url. Inspect journalctl -u piworker."
    print_access
    exit 0
fi
if [ "$managed" = 0 ]; then
    [ "$action" != update ] || die "PiWorker is not installed. Run install first."
    if [ -e "$BIN/piworker" ] || [ -e "$UNIT" ] || [ -e "$BIN/piworkerctl" ]; then
        die "An unmanaged installation exists. Move it aside before installing; its data is not migrated automatically."
    fi
fi

case "$(uname -m)" in
    x86_64|amd64) arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    armv7l|armv8l) arch=arm ;;
    *) die "Unsupported CPU architecture: $(uname -m). ARMv6 is not supported." ;;
esac
for dependency in curl tar install useradd; do
    command -v "$dependency" >/dev/null || die "Missing $dependency. Install it with your OS package manager first."
done
if command -v sha256sum >/dev/null; then
    checksum=(sha256sum)
elif command -v shasum >/dev/null; then
    checksum=(shasum -a 256)
else
    die "Install sha256sum or shasum to verify downloads."
fi
download() { curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 --connect-timeout 15 --max-time 300 "$@"; }
work=$(mktemp -d)
if [ -n "${PIWORKER_RELEASE_DIR:-}" ] && [ -z "$version" ]; then
    die "Local releases require an explicit vVERSION."
fi
if [ -z "$version" ]; then
    resolved=$(download -o /dev/null -w '%{url_effective}' "$RELEASES/latest")
    version=${resolved##*/}
    [[ "$version" =~ ^v[0-9][a-zA-Z0-9.+-]*$ ]] || die "Could not resolve a stable release. Specify vVERSION."
fi
archive=piworker-linux-$arch.tar.gz
if [ -n "${PIWORKER_RELEASE_DIR:-}" ]; then
    echo "Reading local PiWorker $version ($arch)..."
    cp "$PIWORKER_RELEASE_DIR/$archive" "$work/$archive"
    cp "$PIWORKER_RELEASE_DIR/SHA256SUMS" "$work/SHA256SUMS"
else
    echo "Downloading PiWorker $version ($arch)..."
    download "$RELEASES/download/$version/$archive" -o "$work/$archive"
    download "$RELEASES/download/$version/SHA256SUMS" -o "$work/SHA256SUMS"
fi
# Check exactly the requested archive; manifests contain other architectures too.
expected=$(awk -v file="$archive" '$2 == file || $2 == "./" file {print $1}' "$work/SHA256SUMS")
[[ "$expected" =~ ^[a-fA-F0-9]{64}$ ]] || die "Release checksum missing or ambiguous for $archive."
actual=$("${checksum[@]}" "$work/$archive")
[ "${actual%% *}" = "$expected" ] || die "Checksum mismatch; existing installation was not changed."
# Extract only known regular files, never an entire remote archive as root.
for member in "piworker-linux-$arch" piworkerctl; do
    tar -xOzf "$work/$archive" "$member" > "$work/$member"
    [ -s "$work/$member" ] || die "Release is missing $member."
done
chmod 755 "$work/piworker-linux-$arch"
bash -n "$work/piworkerctl"
"$work/piworker-linux-$arch" -h >/dev/null 2>&1 || die "Binary cannot run on this OS. Linux with glibc 2.35+ is required."

install -d -m 755 "$BIN" "${UNIT%/*}"
mkdir -p "$CONFIG"
if ! id piworker >/dev/null 2>&1; then
    useradd --system --user-group --home-dir "$DATA" --no-create-home --shell /usr/sbin/nologin piworker
fi
install -d -m 750 "$DATA"
chown piworker:piworker "$DATA"
if [ ! -f "$CONFIG/piworker.toml" ]; then
    cat > "$CONFIG/piworker.toml" <<'EOF'
# HTTPS with a local CA on 8443; plain HTTP on 8080 redirects to it.
# Recovery: sudo piworkerctl tls off
addr = ":8443"
http_addr = ":8080"
auth = true

[tls]
mode = "auto"
EOF
fi
chown root:piworker "$CONFIG" "$CONFIG/piworker.toml"
chmod 750 "$CONFIG"
chmod 640 "$CONFIG/piworker.toml"

if [ "$managed" = 1 ]; then
    [ -f "$BIN/piworker" ] || die "Managed binary is missing. Restore it from a backup first."
    mkdir -p "$BACKUPS"
    backup=$(mktemp -d "$BACKUPS/$(date +%Y%m%d-%H%M%S).XXXXXX")
    systemctl stop piworker.service
    # Copy the whole stopped data directory, including SQLite WAL and sidecars.
    if ! cp -a "$DATA" "$backup/data" || ! cp -p "$BIN/piworker" "$backup/piworker" ||
       ! cp -a "$CONFIG" "$backup/config"; then
        systemctl start piworker.service
        die "Backup failed. Existing version restarted."
    fi
    rollback=1
    echo "Backup: $backup"
else
    cat > "$UNIT" <<EOF
[Unit]
Description=PiWorker Automation System
After=network.target

[Service]
Type=simple
User=piworker
Group=piworker
WorkingDirectory=$DATA
ExecStart=$BIN/piworker -config $CONFIG/piworker.toml -db $DATA/piworker.db
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 "$UNIT"
fi
install -m 755 "$work/piworker-linux-$arch" "$BIN/piworker.new"
mv -f "$BIN/piworker.new" "$BIN/piworker"
systemctl daemon-reload
if [ "$managed" = 1 ]; then
    systemctl restart piworker.service
else
    # Mark before startup so a failed first boot can be retried or uninstalled.
    printf '%s\n' "$version" > "$CONFIG/installed-version"
    install -m 755 "$work/piworkerctl" "$BIN/piworkerctl"
    systemctl enable --now piworker.service
fi
wait_healthy || die "Health check failed at $health_url. Inspect journalctl -u piworker."
install -m 755 "$work/piworkerctl" "$BIN/piworkerctl.new"
mv -f "$BIN/piworkerctl.new" "$BIN/piworkerctl"
printf '%s\n' "$version" > "$CONFIG/installed-version"
rollback=0
echo "PiWorker $version is running."
print_access
echo "First setup code: sudo journalctl -u piworker -n 50 --no-pager"
echo "Update: sudo piworkerctl update | Uninstall (keep data): sudo piworkerctl uninstall"
echo "HTTPS problems: sudo piworkerctl tls off (plain HTTP) | sudo piworkerctl tls on"
